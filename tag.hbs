{{!< default}}

<main class="site-main">

    {{#tag}}
    <section class="taxonomy">

        {{#if feature_image}}
            <div class="taxonomy-media u-placeholder square">
                <img class="u-object-fit" src="{{img_url feature_image size="s"}}" alt="{{name}}">
            </div>
        {{/if}}

        <header class="single-header gh-canvas">
            {{#match slug "blog"}}
                <h1 class="single-title tag-lockup tag-lockup-blog">
                    <img src="{{asset "images/blog-lockup-evergreen.svg"}}" alt="{{name}}" width="2666" height="620">
                </h1>
            {{else match slug "newsletters"}}
                <h1 class="single-title tag-lockup tag-lockup-newsletters">
                    <img src="{{asset "images/newsletter-lockup-evergreen.svg"}}" alt="{{name}}" width="3104" height="645">
                </h1>
            {{else}}
                <h1 class="single-title">{{name}}</h1>
            {{/match}}
            {{#if description}}
                <div class="single-excerpt">{{description}}</div>
            {{/if}}
        </header>

    </section>
    {{/tag}}

    <div class="post-feed gh-feed gh-canvas">
        {{#foreach posts}}
            {{> "loop"}}
        {{/foreach}}
    </div>

    {{pagination}}

</main>