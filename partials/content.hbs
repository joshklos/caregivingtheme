<article class="single {{post_class}}">

    {{#match @page.show_title_and_feature_image}}
        {{#if feature_image}}{{#unless no_image}}{{#if @custom.title_over_feature_image}}
            {{!-- Title and meta laid over the feature image --}}
            <header class="single-header single-header-overlay gh-canvas">
                <figure class="single-media single-hero kg-width-{{width}}">
                    <div class="single-hero-frame">
                        <img class="gh-feature-image" srcset="{{> "srcset"}}" sizes="{{#match width "full"}}100vw{{else}}(min-width: 1023px) 920px, calc(90vw){{/match}}" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                        <div class="single-hero-text">
                            {{> "single-heading"}}
                        </div>
                    </div>
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>

                {{> "single-intro"}}
            </header>
        {{else}}
            {{> "single-header"}}
        {{/if}}{{else}}
            {{> "single-header"}}
        {{/unless}}{{else}}
            {{> "single-header"}}
        {{/if}}
    {{/match}}

    <div class="single-content gh-content gh-canvas">
        {{content}}
    </div>

    {{#is "post"}}
    <div class="gh-canvas">
    <footer class="single-footer">

        <div class="single-footer-left">
            {{#prev_post}}
            <div class="navigation navigation-previous">
                <a class="navigation-link" href="{{url}}" aria-label="Previous post">
                    <span class="navigation-icon">{{> "icons/arrow-left"}}</span>
                </a>
            </div>
            {{/prev_post}}
        </div>

        <div class="single-footer-middle">
            {{#if @custom.show_author}}
            <div class="single-footer-top">
                <h3 class="single-footer-title">Published by:</h3>
                <div class="author-list">
                    {{#foreach authors}}
                        <div class="author-image-placeholder u-placeholder square">
                            <a href="{{url}}" title="{{name}}">
                                {{#if profile_image}}
                                    <img class="author-image u-object-fit" src="{{img_url profile_image size="xs"}}" alt="{{name}}" loading="lazy">
                                {{else}}
                                    <span class="u-object-fit">{{> "icons/avatar"}}</span>
                                {{/if}}
                            </a>
                        </div>
                    {{/foreach}}
                </div>
            </div>
            {{/if}}
        </div>

        <div class="single-footer-right">
            {{#next_post}}
            <div class="navigation navigation-next">
                <a class="navigation-link" href="{{url}}" aria-label="Next post">
                    <span class="navigation-icon">{{> "icons/arrow-right"}}</span>
                </a>
            </div>
            {{/next_post}}
        </div>

    </footer>
    </div>
    {{/is}}

</article>